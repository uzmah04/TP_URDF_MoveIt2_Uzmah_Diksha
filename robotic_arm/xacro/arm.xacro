<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ==================== LINKS ==================== -->
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/basement.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.51" length="0.31"/>
            </geometry>
            <origin rpy="0 0 0" xyz="-0.021 0 0.155"/>
        </collision>
        <inertial>
            <mass value="0.115956"/>
            <inertia ixx="0.000073418922" ixy="-0.000000007289" ixz="0.000000000960"
                    iyy="0.000067864916" iyz="-0.000000201342"
                    izz="0.000122999190"/>
        </inertial>
    </link>

    <link name="base_plate">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/base_plate.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin xyz="-0.39 -0.39 -0.56" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.42" length="0.58"/>
            </geometry>
            <origin xyz="0 -0.032 0.292" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.11866"/>
            <inertia ixx="0.000000050137" ixy="0.000000004517" ixz="-0.000000004202"
                    iyy="0.000059873492" iyz="0.000005078977"
                    izz="0.000069684610"/>
        </inertial>
    </link>

    <link name="forward_drive_arm">
