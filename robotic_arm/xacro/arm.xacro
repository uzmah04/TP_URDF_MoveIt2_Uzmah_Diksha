            <geometry>
                <mesh filename="package://robotic_arm/meshes/forward_drive_arm.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="0 -${PI/2} ${PI/2}" xyz="0.19 0.06 -0.08"/>
