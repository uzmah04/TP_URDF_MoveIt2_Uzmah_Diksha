        </inertial>
    </link>

    <link name="right_finger">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/right_finger.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="0 0 -${PI/2}" xyz="-0.1 0.5 -0.1"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.59 0.145 0.092"/>
            </geometry>
            <origin rpy="0 0 -${PI/2}" xyz="-0.03 0.205 -0.054"/>
