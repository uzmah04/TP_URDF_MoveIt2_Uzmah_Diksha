                    iyy="0.000001178072" iyz="0.000000010417"
                    izz="0.000001218606"/>
        </inertial>
    </link>

    <link name="left_finger">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/left_finger.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="0 0 -${PI/2}" xyz="-0.04 0.5 -0.1"/>
            <material name="grey"/>
