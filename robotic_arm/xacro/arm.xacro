                    iyy="0.000001093482" iyz="-0.000000010019"
                    izz="0.000001132166"/>
        </inertial>
    </link>


    <!-- ==================== JOINTS ==================== -->

    <joint name="base_link_to_base_plate" type="fixed">
        <parent link="base_link"/>
        <child link="base_plate"/>
        <origin rpy="0 0 0" xyz="0.01 -0.01 0.307"/>
    </joint>

    <joint name="base_plate_to_forward_drive_arm" type="fixed">
        <parent link="base_plate"/>
        <child link="forward_drive_arm"/>
        <origin rpy="0 0 0" xyz="-0.025 0.036 0.36"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="forward_drive_arm_to_horizontal_arm" type="revolute">
        <parent link="forward_drive_arm"/>
        <child link="horizontal_arm"/>
        <origin rpy="0 0 0" xyz="0 -0.015 0.78"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.6796" upper="0.3325" effort="10.0" velocity="1.0"/>
    </joint>

    <joint name="horizontal_arm_to_claw_support" type="fixed">
        <parent link="horizontal_arm"/>
        <child link="claw_support"/>
        <origin rpy="0 0 0" xyz="0.14 0.82 0.015"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="forward_drive_arm_to_triangular_link" type="revolute">
        <parent link="forward_drive_arm"/>
        <child link="triangular_link"/>
        <origin rpy="0 0 0" xyz="0.15 -0.42 1.03"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.4743" upper="0.2661" effort="5.0" velocity="0.8"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="triangular_link_to_link" type="revolute">
        <parent link="triangular_link"/>
        <child link="link"/>
        <origin rpy="0 0 0" xyz="-0.05 0.46 -0.125"/>
        <axis xyz="1 0 0"/>
        <limit lower="-2.094" upper="2.094" effort="3.0" velocity="0.5"/>
    </joint>

    <joint name="claw_support_to_link" type="fixed">
        <parent link="claw_support"/>
        <child link="link"/>
        <origin rpy="0 0 0" xyz="0.05 0.76 -0.11"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="base_plate_to_vertical_drive_arm" type="revolute">
        <parent link="base_plate"/>
        <child link="vertical_drive_arm"/>
        <origin rpy="0 0 0" xyz="-0.125 0.07 0.3"/>
        <axis xyz="1 0 0"/>
        <limit lower="0" upper="-0.1967" effort="5.0" velocity="0.8"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="vertical_drive_arm_to_link2" type="fixed">
        <parent link="vertical_drive_arm"/>
        <child link="link2"/>
        <origin rpy="0 0 0" xyz="0.05 -0.46 -0.005"/>
        <axis xyz="0 0 1"/>
        <limit lower="-2.094" upper="2.094" effort="3.0" velocity="0.5"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="base_plate_to_link3" type="revolute">
        <parent link="base_plate"/>
        <child link="link3"/>
        <origin rpy="-0.03 0 0" xyz="0.175 -0.255 1.39"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.094" upper="1.094" effort="3.0" velocity="0.5"/>
    </joint>

    <joint name="base_plate_to_servo_plate" type="fixed">
        <parent link="base_plate"/>
        <child link="servo_plate"/>
        <origin rpy="0 0 0" xyz="0.227 -0.11 0.473"/>
    </joint>

    <joint name="base_plate_to_servo_plate2" type="fixed">
        <parent link="base_plate"/>
        <child link="servo_plate2"/>
        <origin rpy="0 0 0" xyz="-0.294 0.153 0.473"/>
    </joint>

    <!-- FIXED: Added limits -->
    <joint name="claw_support_to_right_finger" type="revolute">
        <parent link="claw_support"/>
        <child link="right_finger"/>
        <origin rpy="0 0 0" xyz="-0.040 0.13 -0.08"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.4500" upper="0.000" effort="2.0" velocity="0.5"/>
    </joint>

    <!-- FIXED: Added limits - mimic joint also needs limits -->
    <joint name="claw_support_to_left_finger" type="revolute">
        <parent link="claw_support"/>
        <child link="left_finger"/>
        <origin rpy="0 0 0" xyz="-0.213 0.13 -0.08"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.4500" upper="0.000" effort="2.0" velocity="0.5"/>
        <mimic joint="claw_support_to_right_finger" multiplier="-1"/>
    </joint>

</robot>