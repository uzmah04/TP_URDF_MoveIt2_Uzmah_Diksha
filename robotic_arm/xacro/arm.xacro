                    izz="0.000067270164"/>
        </inertial>
    </link>

    <link name="link3">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/link.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="-${PI} ${PI/2} 0" xyz="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.121 0.06 0.921"/>
            </geometry>
            <origin rpy="0 0 ${PI/2}" xyz="-0.025 -0.0605 -0.468"/>
        </collision>
        <inertial>
            <mass value="0.007673"/>
            <inertia ixx="0.000000061348" ixy="-0.000000000001" ixz="0.00000000000018"
                    iyy="0.000006695415" iyz="-0.00000000000002"
                    izz="0.000067270164"/>
        </inertial>
    </link>

    <link name="servo_plate">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/servo_plate.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="0 ${PI/2} 0" xyz="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.262 0.03 0.342"/>
            </geometry>
            <origin rpy="0 0 ${PI/2}" xyz="0.01 0.131 -0.171"/>
        </collision>
        <inertial>
            <mass value="0.003430"/>
            <inertia ixx="0.000000249079" ixy="0" ixz="0.000000000016"
                    iyy="0.000000386663" iyz="0"
                    izz="0.000000632241"/>
        </inertial>
    </link>

    <link name="servo_plate2">
        <visual>
            <geometry>
                <mesh filename="package://robotic_arm/meshes/servo_plate.STL" scale="0.01 0.01 0.01"/>
            </geometry>
            <origin rpy="${PI} ${PI/2} 0" xyz="0 0 0"/>
            <material name="grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.262 0.03 0.342"/>
            </geometry>
            <origin rpy="0 0 ${PI/2}" xyz="-0.01 -0.131 -0.171"/>
